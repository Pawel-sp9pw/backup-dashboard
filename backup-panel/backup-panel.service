[Unit]
Description=PC MED Backup Panel
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=backup-panel
Group=backup-panel
WorkingDirectory=/opt/backup-panel
EnvironmentFile=/etc/backup-panel.env
ExecStart=/opt/backup-panel/venv/bin/python /opt/backup-panel/app.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
