# Default remains PREVIEW; no files moved or deleted.
PCMED_RETENTION_EXECUTE=0
# 0 = never permanently delete quarantined backups.
PCMED_RETENTION_PURGE=0
PCMED_RETENTION_GRACE_DAYS=14
PCMED_RETENTION_MIN_AGE_HOURS=48
PCMED_RETENTION_MAX_MOVES=20
PCMED_RETENTION_ROOT=/home
PCMED_RETENTION_QUARANTINE=/home/.pcmed-retention-quarantine
PCMED_RETENTION_API=http://127.0.0.1:8080/api/clients/backup
PCMED_RETENTION_STATUS_API=http://127.0.0.1:8080/api/status
PCMED_RETENTION_LOG=/var/log/pcmed-retention.jsonl
